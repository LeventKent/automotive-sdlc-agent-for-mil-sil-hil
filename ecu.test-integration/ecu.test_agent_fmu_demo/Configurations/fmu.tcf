<?xml version="1.0" encoding="utf-8"?>
<CONFIGURATION format-rev="11" prog-version="2026.1.1.175686+a96598cbdfd5" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test application.configuration.xsd">
	<COMMON format-rev="4" xsi:type="commonData">
		<QUERY-TESTER xsi:type="integer">2</QUERY-TESTER>
		<MAPPING-FILES>
			<ELEMENT format-rev="1" xsi:type="localArtifactReference">
				<EXPRESSION xsi:type="expressionref">
					<PATH-EXPRESSION format-rev="2" xsi:type="valueBaseExpression">
						<VALUE xsi:type="string">Parameters/FMU/fmu_global.xam</VALUE>
					</PATH-EXPRESSION>
				</EXPRESSION>
			</ELEMENT>
		</MAPPING-FILES>
	</COMMON>
	<REPORT format-rev="4" xsi:type="reportData">
		<REPORT-FORMATES/>
		<INCLUDE-APPLICATION-LOGS xsi:type="boolean">True</INCLUDE-APPLICATION-LOGS>
	</REPORT>
	<EXECUTION-DATA format-rev="2" xsi:type="executionData"/>
	<MODEL-ACCESS format-rev="1" xsi:type="modelAccessData">
		<DATA dkey="Plant model">
			<DVALUE format-rev="1" xsi:type="modelData">
				<MODEL-DATA-SOURCE xsi:type="integer">0</MODEL-DATA-SOURCE>
				<MODEL-ACCESS-PORT xsi:type="string">MDL01</MODEL-ACCESS-PORT>
				<MODEL-FILE xsi:type="string">TemperatureMonitoringSystem_win64.fmu</MODEL-FILE>
				<MODEL-POSITION xsi:type="integer">1</MODEL-POSITION>
			</DVALUE>
		</DATA>
	</MODEL-ACCESS>
</CONFIGURATION>
